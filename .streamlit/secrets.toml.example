# Modèle de secrets — NE PAS mettre les vraies valeurs dans ce fichier.
#
# En local : copier ce fichier en  .streamlit/secrets.toml  (ignoré par git)
# Sur Streamlit Cloud : coller ces lignes dans  App → Settings → Secrets

# --- Administrateur : seul lui peut publier un nouvel export Kobo -------------
ADMIN_PASSWORD = "choisir_un_mot_de_passe_solide"

# --- Stockage permanent des données publiées (dépôt GitHub PRIVÉ) ------------
# Jeton « fine-grained » : github.com → Settings → Developer settings → Personal access tokens
#   → Fine-grained tokens → accès au SEUL dépôt de données → Permissions : Contents = Read and write
GITHUB_TOKEN = "github_pat_xxxxxxxxxxxxxxxx"
DATA_REPO = "ouehi-mario/dashboard-thrive-data"   # dépôt PRIVÉ, différent du dépôt du code
# DATA_PATH = "export_kobo.xlsx"                  # facultatif
# DATA_BRANCH = "main"                            # facultatif

# --- Photos des symptômes (facultatif) ---------------------------------------
# Kobo → Paramètres du compte → Sécurité → Clé API
KOBO_TOKEN = "colle_ta_cle_api_kobo_ici"
